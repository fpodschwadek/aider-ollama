# Ollama model name, including the parameter size if available.
MODEL=codellama:7b
# Folder aider works in. Defaults to ./project.
PROJECT_PATH=./project
# Context window in tokens; Ollama's own default is too small for aider.
CONTEXT_LENGTH=8192
# Small models cope better with "whole" than with "diff".
EDIT_FORMAT=whole
# Set to true to let aider commit its changes to a git repository in PROJECT_PATH
# (enables /undo and /diff; the folder must be a git repository with a configured user).
GIT=false
